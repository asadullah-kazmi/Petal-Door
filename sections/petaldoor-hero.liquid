<section
  class="petaldoor-hero petaldoor-hero--{{ section.settings.layout | default: 'split' }}"
  aria-labelledby="PetalDoorHeroHeading-{{ section.id }}"
>
  <div class="petaldoor-hero__content">
    <p class="petaldoor-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 id="PetalDoorHeroHeading-{{ section.id }}" class="petaldoor-hero__heading">
      {{ section.settings.heading }}
    </h1>
    <div class="petaldoor-hero__text rte">{{ section.settings.text }}</div>

    <div class="petaldoor-hero__actions">
      {% if section.settings.primary_label != blank %}
        <a class="button petaldoor-hero__primary" href="{{ section.settings.primary_link }}">
          {{ section.settings.primary_label | escape }}
        </a>
      {% endif %}
      {% if section.settings.secondary_label != blank %}
        <a class="petaldoor-hero__secondary" href="{{ section.settings.secondary_link }}">
          {{ section.settings.secondary_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

    <ul class="petaldoor-hero__proof" role="list">
      <li><span aria-hidden="true">✦</span> Made fresh today</li>
      <li><span aria-hidden="true">✦</span> Photo before delivery</li>
      <li><span aria-hidden="true">✦</span> Handwritten card included</li>
    </ul>
  </div>

  <a class="petaldoor-hero__media" href="{{ section.settings.primary_link }}" aria-label="{{ section.settings.primary_label | escape }}">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          alt: section.settings.image_alt,
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          fetchpriority: 'high',
          loading: 'eager'
      }}
    {%- else -%}
      <img
        src="{{ 'petaldoor-hero-v1.png' | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        width="1680"
        height="945"
        fetchpriority="high"
      >
    {%- endif -%}
    <span class="petaldoor-hero__media-label">
      <strong>Curated by hand</strong>
      <small>Delivered across the UAE</small>
    </span>
  </a>
</section>

{% stylesheet %}
  .petaldoor-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    min-height: clamp(620px, 74svh, 820px);
    background: #efebe3;
    overflow: hidden;
  }

  .petaldoor-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(52px, 7vw, 112px) clamp(28px, 5vw, 88px);
    position: relative;
    z-index: 1;
  }

  .petaldoor-hero__eyebrow {
    color: #530727;
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    margin: 0 0 22px;
    text-transform: uppercase;
  }

  .petaldoor-hero__heading {
    color: #1a1a1a;
    font-family: var(--font-heading--family);
    font-size: clamp(3.5rem, 5.5vw, 6.8rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.91;
    margin: 0;
    max-width: 8.4ch;
    text-wrap: balance;
  }

  .petaldoor-hero__heading em {
    color: #530727;
    font-weight: 400;
  }

  .petaldoor-hero__text {
    color: #4f4f4b;
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.65;
    margin-top: 28px;
    max-width: 520px;
  }

  .petaldoor-hero__text p { margin: 0; }

  .petaldoor-hero__actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 34px;
  }

  .petaldoor-hero__primary {
    background: #530727;
    border-color: #530727;
    min-width: 176px;
  }

  .petaldoor-hero__primary:hover {
    background: #3d051c;
    border-color: #3d051c;
  }

  .petaldoor-hero__secondary {
    align-items: center;
    color: #1a1a1a;
    display: inline-flex;
    font-weight: 600;
    gap: 9px;
    text-decoration: none;
  }

  .petaldoor-hero__secondary span { transition: transform 180ms ease; }
  .petaldoor-hero__secondary:hover span { transform: translateX(4px); }

  .petaldoor-hero__proof {
    color: #4f4f4b;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.75rem;
    gap: 10px 18px;
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
  }

  .petaldoor-hero__proof li { align-items: center; display: flex; gap: 7px; }
  .petaldoor-hero__proof span { color: #530727; }

  .petaldoor-hero__media {
    display: block;
    min-height: 100%;
    overflow: hidden;
    position: relative;
  }

  .petaldoor-hero__media::after {
    background: linear-gradient(90deg, rgb(47 32 36 / 8%), transparent 26%);
    content: '';
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .petaldoor-hero__media img {
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
    width: 100%;
  }

  .petaldoor-hero__media:hover img { transform: scale(1.018); }

  .petaldoor-hero__media-label {
    backdrop-filter: blur(12px);
    background: rgb(255 250 247 / 86%);
    bottom: 28px;
    color: #1a1a1a;
    display: flex;
    flex-direction: column;
    gap: 2px;
    left: 28px;
    padding: 14px 18px;
    position: absolute;
    z-index: 1;
  }

  .petaldoor-hero__media-label strong {
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .petaldoor-hero__media-label small { color: #4f4f4b; font-size: 0.72rem; }

  @media screen and (max-width: 989px) {
    .petaldoor-hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .petaldoor-hero__content { padding: 52px 28px 46px; }
    .petaldoor-hero__heading { font-size: clamp(3.35rem, 15vw, 5.4rem); }
    .petaldoor-hero__media { aspect-ratio: 4 / 3; min-height: 0; }
    .petaldoor-hero__media img { object-position: 64% center; }
  }

  @media screen and (max-width: 549px) {
    .petaldoor-hero__actions { align-items: stretch; flex-direction: column; gap: 18px; }
    .petaldoor-hero__primary { width: 100%; }
    .petaldoor-hero__secondary { justify-content: center; }
    .petaldoor-hero__proof { display: grid; grid-template-columns: 1fr; margin-top: 30px; }
    .petaldoor-hero__media-label { bottom: 16px; left: 16px; }
  }

  /* Full-width banner: photo fills the section, text sits centred over a light wash on the right */
  .petaldoor-hero--banner {
    display: block;
    min-height: clamp(460px, 62svh, 640px);
    position: relative;
  }

  .petaldoor-hero--banner .petaldoor-hero__media {
    inset: 0;
    position: absolute;
  }

  .petaldoor-hero--banner .petaldoor-hero__media::after {
    background: linear-gradient(90deg, transparent 34%, rgb(247 246 242 / 78%) 64%, rgb(247 246 242 / 88%));
  }

  .petaldoor-hero--banner .petaldoor-hero__media-label { display: none; }

  .petaldoor-hero--banner .petaldoor-hero__content {
    align-items: center;
    margin-inline-start: auto;
    min-height: inherit;
    pointer-events: none;
    text-align: center;
    width: min(46%, 600px);
  }

  .petaldoor-hero--banner .petaldoor-hero__content > * { pointer-events: auto; }

  .petaldoor-hero--banner .petaldoor-hero__heading {
    font-size: clamp(2.25rem, 3.4vw, 3.25rem);
    letter-spacing: 0;
    line-height: 1.1;
    max-width: none;
  }

  .petaldoor-hero--banner .petaldoor-hero__heading em { font-style: normal; }

  .petaldoor-hero--banner .petaldoor-hero__text {
    font-style: italic;
    margin-inline: auto;
    max-width: 440px;
  }

  .petaldoor-hero--banner .petaldoor-hero__actions,
  .petaldoor-hero--banner .petaldoor-hero__proof { justify-content: center; }

  .petaldoor-hero--banner .petaldoor-hero__primary {
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .petaldoor-hero--banner { display: flex; flex-direction: column-reverse; min-height: auto; }
    .petaldoor-hero--banner .petaldoor-hero__media { aspect-ratio: 4 / 3; position: relative; }
    .petaldoor-hero--banner .petaldoor-hero__media::after { display: none; }
    .petaldoor-hero--banner .petaldoor-hero__content { min-height: 0; width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .petaldoor-hero__media img,
    .petaldoor-hero__secondary span { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PetalDoor hero",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "split",
          "label": "Split: text beside image"
        },
        {
          "value": "banner",
          "label": "Full-width banner"
        }
      ],
      "default": "split"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the built-in PetalDoor hero image."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Same-day delivery · All 7 Emirates"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Flowers that say it <em>beautifully</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Hand-tied bouquets and luxury arrangements, crafted fresh every morning in Dubai and delivered with care.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop bestsellers"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link label",
      "default": "Shop by occasion"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Luxury bouquet of roses, peonies and orchids arranged in a sculptural vase"
    }
  ],
  "presets": [
    {
      "name": "PetalDoor hero"
    }
  ]
}
{% endschema %}
